{
  "compilerOptions": {
    "declaration": true,
    "lib": ["esnext"],
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": ".",
    "outDir": "build",
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "target": "es2022",
    "types": ["node", "mocha"]
  },
  "include": ["source/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/modules", "tests/file.tsx"]
}

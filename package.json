{
  "name": "@agdust/eslint-plugin-etc",
  "version": "3.0.0",
  "description": "TypeScript ESLint rules from eslint-plugin-etc that have no modern equivalent. Maintained fork for ESLint 9/10 flat config.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "typescript",
    "flat-config"
  ],
  "license": "MIT",
  "author": "Nicholas Jamieson <nicholas@cartant.com>",
  "contributors": [
    "Mikhail Nekrytov <mail@nekrytov.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agdust/eslint-plugin-etc.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig-dist.json",
    "lint": "eslint .",
    "prettier": "prettier --write \"./{source,tests}/**/*.{js,json,ts,tsx}\"",
    "prettier:ci": "prettier --check \"./{source,tests}/**/*.{js,json,ts,tsx}\"",
    "test": "mocha --require tsx/cjs --timeout 20000 \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "dependencies": {
    "@phenomnomnominal/tsquery": "^6.2.0",
    "@typescript-eslint/utils": "^8.71.0",
    "ts-api-utils": "^2.5.0"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/rule-tester": "^8.71.0",
    "common-tags": "^1.8.2",
    "eslint": "^10.11.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0"
  }
}
